---
title: AI Development Platform — workspace microVM, host service tier, and model data path
---
flowchart LR
  classDef vm fill:#eef6ff,stroke:#3b82f6,stroke-width:2px,color:#0b3a6b;
  classDef gw fill:#fff7e6,stroke:#f59e0b,stroke-width:2px,color:#7a4a05;
  classDef core fill:#eafaf0,stroke:#16a34a,stroke-width:2px,color:#0b4a25;
  classDef store fill:#f3f0ff,stroke:#7c3aed,stroke-width:1.5px,color:#3b1d80;
  classDef opt fill:#f4f4f5,stroke:#9ca3af,stroke-width:1.5px,stroke-dasharray:4 3,color:#374151;
  classDef cloud fill:#fdecec,stroke:#dc2626,stroke-width:2px,color:#7a1212;

  subgraph WS["Workspace · Microsandbox microVM (one per project)"]
    direction TB
    AGENT["Agent CLI<br/>opencode · pi · claude · codex · gemini<br/><b>holds only a scoped LiteLLM virtual key</b>"]:::vm
    RT["In-VM container runtime<br/>rootful containerd · nerdctl · runc · CNI"]:::core
    TOOLS["Baked-in dev tooling<br/>Node.js · Python 3 · uv · <b>Graphify</b> (graphifyy, uv tool install)<br/>registered with each agent CLI at start · per-project ~/project/.venv-msb"]:::core
    APPS["Opt-in in-VM apps (nerdctl)<br/>Open WebUI · AnythingLLM<br/>per-(workspace,app) host port · /workspace mount"]:::opt
  end

  subgraph TIER["Host · Docker service tier (aip-net) — internal-only but nginx (loopback: DB, DNS)"]
    direction TB
    PROXY["nginx gateway · aip-proxy<br/>host :18787 — <b>SOLE host entry</b>, TLS-ready<br/>/ &amp; /v1 → LiteLLM · /llm → LiteLLM · /ollama → Ollama<br/>vhost: litellm.&lt;domain&gt;"]:::gw
    HEAD["Headroom · aip-headroom :8787<br/>input-compression guardrail service<br/>LiteLLM calls in-process (internal-only)"]:::gw
    LLM["LiteLLM · aip-litellm :4000<br/><b>router + user-selectable guardrails</b><br/>(Headroom on by default; secret-masking/<br/>hide-secrets/tool-firewall opt-in)<br/>admin UI via /llm + litellm.&lt;domain&gt; (internal-only)"]:::core
    PG[("Postgres · aip-litellm-db<br/>(loopback :5442)<br/>virtual keys · spend · provider creds")]:::store
    PRES["Presidio · aip-presidio-{analyzer,anonymizer}<br/>secret masking (pre/post-call)"]:::core
    OLL["Ollama · aip-ollama :11434<br/>local models (no default · DB-backed · internal-only)"]:::core
    DNS["CoreDNS · aip-dns (loopback :15353)<br/>egress audit log"]:::core
  end

  CLI["Host CLI / UI<br/>loopback 127.0.0.1:18787"]:::vm
  CLOUD["Cloud providers<br/>OpenAI · Anthropic · Gemini · Groq<br/><b>real provider keys live in LiteLLM</b>"]:::cloud

  AGENT == "OpenAI API · base_url http://host.microsandbox.internal:18787/v1<br/>egress default PUBLIC (DNS-audited) — re-lockable to deny" ==> PROXY
  APPS == "same gateway path (model calls)" ==> PROXY
  CLI -- "/v1 model path · /llm + /ollama admin" --> PROXY
  AGENT -. "every DNS name audited" .-> DNS
  AGENT -. "consults <b>Graphify</b> knowledge graph" .-> TOOLS
  PROXY -- "/ + /v1" --> LLM
  PROXY -. "/llm · litellm.&lt;domain&gt;" .-> LLM
  PROXY -. "/ollama" .-> OLL
  LLM -- "pre_call compress" --> HEAD
  LLM <-. "guardrails (when enabled)" .-> PRES
  LLM --- PG
  LLM -- "local route" --> OLL
  LLM == "cloud route (real key attached)" ==> CLOUD
