---
title: AI Development Platform — nono-sandboxed agent sessions, host service tier, and model data path
---
flowchart LR
  classDef host fill:#eef6ff,stroke:#3b82f6,stroke-width:2px,color:#0b3a6b;
  classDef gw fill:#fff7e6,stroke:#f59e0b,stroke-width:2px,color:#7a4a05;
  classDef core fill:#eafaf0,stroke:#16a34a,stroke-width:2px,color:#0b4a25;
  classDef store fill:#f3f0ff,stroke:#7c3aed,stroke-width:1.5px,color:#3b1d80;
  classDef opt fill:#f4f4f5,stroke:#9ca3af,stroke-width:1.5px,stroke-dasharray:4 3,color:#374151;
  classDef cloud fill:#fdecec,stroke:#dc2626,stroke-width:2px,color:#7a1212;

  subgraph WS["Workspace · nono session — host process, sandboxed per launch (no VM, no image)"]
    direction TB
    AGENT["Agent CLI (plain host process)<br/>opencode · omp · claude-code · codex · gemini · hermes<br/><b>holds only a scoped LiteLLM virtual key</b><br/>sandboxed per-invocation by nono (Landlock/Seatbelt)"]:::host
    PROFILE["nono profile (JSON)<br/>.ai-platform/nono-profile-&lt;cli&gt;.json<br/>filesystem scope (project dir) + network policy<br/>(egress deny|public, allow/deny domains)"]:::host
    KEYCHAIN[("OS keychain<br/>scoped gateway key, injected via<br/>nono --env-credential-map<br/>(never written to disk)")]:::store
    AITOOLS["Opt-in AI tools (--tools / ai tools enable)<br/><b>caveman · graphify · code-review-graph · codebase-memory-mcp ·<br/>openviking · tokensave · agentmemory · ponytail · agent-skills</b><br/>install directly on the host at the next session launch"]:::opt
  end

  subgraph TIER["Host · Docker service tier (aip-net) — internal-only but nginx (loopback: DNS only)"]
    direction TB
    PROXY["nginx gateway · aip-proxy<br/>host :18787 — <b>SOLE host entry</b>, TLS-ready<br/>/ &amp; /v1 → LiteLLM · /llm → LiteLLM<br/>vhosts: litellm.&lt;domain&gt; · valkey.&lt;domain&gt;"]:::gw
    HEAD["Headroom · aip-headroom :8787<br/>input-compression guardrail service<br/>LiteLLM calls in-process (internal-only)"]:::gw
    LLM["LiteLLM · aip-litellm :4000<br/><b>router + user-selectable guardrails</b><br/>(Headroom on by default; secret-masking/<br/>hide-secrets/tool-firewall opt-in)<br/>admin UI via /llm + litellm.&lt;domain&gt; (internal-only)"]:::core
    PG[("Postgres · aip-litellm-db :5432<br/>(internal-only · no host port)<br/>virtual keys · spend · provider creds")]:::store
    PRES["Presidio · aip-presidio-{analyzer,anonymizer}<br/>secret masking (pre/post-call)"]:::core
    VALKEY[("Valkey · aip-valkey :6379<br/>LiteLLM response cache (standalone · internal-only)")]:::store
    RI["RedisInsight · aip-redisinsight :5540<br/>Valkey GUI · vhost valkey.&lt;domain&gt; (internal-only)"]:::gw
    DNS["CoreDNS · aip-dns (loopback :15353)<br/>egress audit log"]:::core
  end

  CLI["Host CLI / UI<br/>loopback 127.0.0.1:18787"]:::host
  OMLX["omlx (host-native · sole local backend · macOS/Apple Silicon)<br/>ONE shared <b>omlx serve --model-dir &lt;dir&gt; --port 8100</b><br/>reached via host.docker.internal · models managed in omlx's OWN admin panel<br/>public handle omlx/&lt;id&gt; (DB-backed · no default)"]:::core
  CLOUD["Cloud providers<br/>OpenAI · Anthropic · Gemini · Groq<br/><b>real provider keys live in LiteLLM</b>"]:::cloud

  PROFILE -. "generated/refreshed at every launch" .-> AGENT
  KEYCHAIN -. "--env-credential-map (never on disk)" .-> AGENT
  AGENT == "OpenAI API · base_url http://127.0.0.1:18787/v1<br/>egress default PUBLIC — re-lockable to deny (ai network egress)" ==> PROXY
  CLI -- "/v1 model path · /llm admin" --> PROXY
  AGENT -. "DNS queries audited host-wide" .-> DNS
  AGENT -. "consults <b>Graphify</b> knowledge graph" .-> AITOOLS
  PROXY -- "/ + /v1" --> LLM
  PROXY -. "/llm · litellm.&lt;domain&gt;" .-> LLM
  LLM -- "pre_call compress" --> HEAD
  LLM <-. "guardrails (when enabled)" .-> PRES
  LLM --- PG
  LLM == "local route · host.docker.internal:8100/v1" ==> OMLX
  LLM -. "response cache" .-> VALKEY
  RI -. "monitors" .-> VALKEY
  PROXY -. "valkey.&lt;domain&gt;" .-> RI
  LLM == "cloud route (real key attached)" ==> CLOUD
