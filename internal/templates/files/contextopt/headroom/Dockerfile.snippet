# context optimization: headroom (input compression)
# Installed in EVERY workspace — it runs as a local proxy that wraps the agent
# CLI, compressing tool outputs / files / logs before they reach the model
# (arch §8–10). It reads the project's context.strategy. Caveman (output
# compression) is its per-project complement, seeded as an agent skill.
# Verify the exact install on hardware bring-up before relying on this.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && pip3 install --no-cache-dir --break-system-packages 'headroom-ai[proxy]'
USER workspace
