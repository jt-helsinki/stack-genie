# tool: graphify (github.com/Graphify-Labs/graphify, PyPI `graphifyy`) — appended to the
# project Dockerfile ONLY when selected at `ai create` (context.graphify_enabled, default
# on). A knowledge-graph skill for AI coding assistants; each selected agent-CLI snippet
# then registers it at workspace start via `graphify install --platform …`
# (workspace.registerGraphify). The optional extras are bundled (all incl. mcp except the
# region/DB/niche-specific chinese, azure, bedrock, falkordb, neo4j, leiden, dm, pascal).
# Installed via uv onto the workspace user's ~/.local/bin (uv itself is in the base layer).
USER workspace
RUN uv tool install --no-cache "graphifyy[pdf,office,video,postgres,google,svg,sql,terraform,ollama,openai,gemini,anthropic,mcp]" \
 && rm -rf "$HOME/.cache/uv"
