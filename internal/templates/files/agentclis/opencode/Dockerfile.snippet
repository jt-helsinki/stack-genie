# agent CLI: opencode (the default)
# Node is installed in the OS base image (pinned Node 22 LTS), so this only adds
# the CLI. Verify the exact npm package on hardware bring-up before relying on this.
USER root
RUN npm install -g opencode-ai
USER workspace

# Register Graphify with OpenCode (github.com/safishamsi/graphify). Best-effort:
# never fail the image build.
RUN cd ~/workspace && graphify install --project --platform opencode || echo "graphify: opencode registration skipped (verify on hardware bring-up)"
