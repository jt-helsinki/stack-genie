# agent CLI: claude-code
# Node is installed in the OS base image (pinned Node 22 LTS), so this only adds
# the CLI. Verify the exact npm package on hardware bring-up before relying on this.
USER root
RUN npm install -g @anthropic-ai/claude-code
USER workspace

# Register Graphify with Claude Code so it consults the knowledge graph automatically
# (github.com/safishamsi/graphify — Claude Code is the default `graphify install`
# platform). Best-effort: never fail the image build.
RUN cd ~/workspace && graphify install --project install || echo "graphify: claude-code registration skipped (verify on hardware bring-up)"
