# agent CLI: codex
# Node is installed in the OS base image (pinned Node 24 LTS), so this only adds
# the CLI. Verify the exact npm package on hardware bring-up before relying on this.
USER root
RUN npm install -g @openai/codex
USER workspace

# Register Graphify with Codex (github.com/safishamsi/graphify). Best-effort: never
# fail the image build.
RUN cd ~/workspace && graphify install --project --platform codex || echo "graphify: codex registration skipped (verify on hardware bring-up)"
