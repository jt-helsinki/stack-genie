# agent CLI: codex
# Verify the exact npm package on hardware bring-up before relying on this.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @openai/codex
USER workspace

# Register Graphify with Codex (github.com/safishamsi/graphify). Best-effort: never
# fail the image build.
RUN graphify install --platform codex || echo "graphify: codex registration skipped (verify on hardware bring-up)"
