# agent CLI: gemini (Gemini CLI)
# Verify the exact npm package on hardware bring-up before relying on this.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @google/gemini-cli
USER workspace

# Register Graphify with the Gemini CLI (github.com/safishamsi/graphify). Best-effort:
# never fail the image build.
RUN graphify install --platform gemini || echo "graphify: gemini registration skipped (verify on hardware bring-up)"
