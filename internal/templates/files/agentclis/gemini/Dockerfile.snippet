# agent CLI: gemini (Gemini CLI)
# Node is installed in the OS base image (pinned Node 22 LTS), so this only adds
# the CLI. Verify the exact npm package on hardware bring-up before relying on this.
USER root
RUN npm install -g @google/gemini-cli
USER workspace

# Register Graphify with the Gemini CLI (github.com/safishamsi/graphify). Best-effort:
# never fail the image build.
RUN cd ~/workspace && graphify install --project --platform gemini || echo "graphify: gemini registration skipped (verify on hardware bring-up)"
